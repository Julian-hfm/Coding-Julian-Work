<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8"> <!-- Setzt den Zeichensatz auf UTF-8 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Setzt das Viewport-Tag für Responsive Design -->
    <title>Rock Paper Scissors - Support</title> <!-- Definiert den Titel der Seite -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet"> <!-- Verlinkt die Roboto-Schriftart von Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous"> <!-- Verlinkt Bootstrap CSS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous">
    </script> <!-- Verlinkt Bootstrap JS -->

    <style>
        body, html {
            height: 100%; /* Setzt die Höhe von body und html auf 100% */
            margin: 0; /* Entfernt die Standard-Margin */
            display: flex; /* Setzt das Flexbox-Layout */
            flex-direction: column; /* Anordnung der Flex-Elemente in einer Spalte */
            align-items: center; /* Zentriert die Flex-Elemente horizontal */
            justify-content: flex-start; /* Positioniert die Flex-Elemente oben */
            font-family: 'Roboto', sans-serif; /* Setzt die Schriftart auf Roboto */
            color: #5a9bd4; /* Setzt die Textfarbe auf Hellblau */
        }

        .main-container {
            display: flex; /* Verwendet das Flexbox-Layout */
            justify-content: center; /* Zentriert die Flex-Elemente horizontal */
            align-items: flex-start; /* Positioniert die Flex-Elemente am oberen Rand */
            width: 100%; /* Setzt die Breite auf 100% */
            height: 100%; /* Setzt die Höhe auf 100% */
            margin-top: 100px; /* Setzt den oberen Rand auf 100 Pixel */
        }

        .container {
            display: flex; /* Verwendet das Flexbox-Layout */
            flex-direction: column; /* Anordnung der Flex-Elemente in einer Spalte */
            align-items: flex-start; /* Zentriert die Flex-Elemente am linken Rand */
            width: 80%; /* Setzt die Breite auf 80% */
            max-width: 800px; /* Setzt die maximale Breite auf 800 Pixel */
        }

        .input-container {
            display: flex; /* Verwendet das Flexbox-Layout */
            align-items: center; /* Zentriert die Flex-Elemente vertikal */
            justify-content: center; /* Zentriert die Flex-Elemente horizontal */
            width: 100%; /* Setzt die Breite auf 100% */
            margin-left: -50px; /* Setzt den linken Rand auf -50 Pixel */
        }

        h1, h2 {
            text-align: center; /* Zentriert den Text */
            margin: 10px 0; /* Setzt den oberen und unteren Rand auf 10 Pixel */
        }

        .input-wrapper {
            display: flex; /* Verwendet das Flexbox-Layout */
            align-items: center; /* Zentriert die Flex-Elemente vertikal */
            border: 2px solid #5a9bd4; /* Setzt eine 2 Pixel breite, hellblaue Umrandung */
            border-radius: 12px; /* Macht die Ecken der Umrandung abgerundet */
            background-color: white; /* Setzt die Hintergrundfarbe auf Weiß */
            padding: 20px; /* Setzt den Innenabstand auf 20 Pixel */
            margin-right: 20px; /* Setzt den rechten Rand auf 20 Pixel */
            flex-grow: 1; /* Lässt das Element wachsen, um den verfügbaren Platz zu füllen */
            font-size: 24px; /* Setzt die Schriftgröße auf 24 Pixel */
            height: 60px; /* Setzt die Höhe auf 60 Pixel */
        }

        .input-wrapper input {
            border: none; /* Entfernt die Standard-Umrandung */
            outline: none; /* Entfernt den Standard-Umriss */
            font-size: 24px; /* Setzt die Schriftgröße auf 24 Pixel */
            text-align: center; /* Zentriert den Text */
            flex-grow: 1; /* Lässt das Element wachsen, um den verfügbaren Platz zu füllen */
            height: 100%; /* Setzt die Höhe auf 100% */
        }

        .support-button {
            padding: 10px 20px; /* Setzt den Innenabstand auf 10 Pixel oben und unten, 20 Pixel links und rechts */
            border: 2px solid #5a9bd4; /* Setzt eine 2 Pixel breite, hellblaue Umrandung */
            background-color: white; /* Setzt die Hintergrundfarbe auf Weiß */
            color: #5a9bd4; /* Setzt die Textfarbe auf Hellblau */
            cursor: pointer; /* Ändert den Mauszeiger auf eine Hand bei Hover */
            transition: background-color 0.3s, color 0.3s; /* Fügt eine Übergangsanimation von 0,3 Sekunden hinzu */
            border-radius: 12px; /* Macht die Ecken der Umrandung abgerundet */
            text-align: center; /* Zentriert den Text */
            font-size: 18px; /* Setzt die Schriftgröße auf 18 Pixel */
            height: 60px; /* Setzt die Höhe auf 60 Pixel */
            white-space: nowrap; /* Verhindert den Zeilenumbruch */
            display: flex; /* Verwendet das Flexbox-Layout */
            align-items: center; /* Zentriert die Flex-Elemente vertikal */
            justify-content: center; /* Zentriert die Flex-Elemente horizontal */
        }

        .support-button:hover {
            background-color: #5a9bd4; /* Ändert die Hintergrundfarbe auf Hellblau bei Hover */
            color: white; /* Ändert die Textfarbe auf Weiß bei Hover */
        }

        .home-button {
            width: 40px; /* Setzt die Breite auf 40 Pixel */
            height: 40px; /* Setzt die Höhe auf 40 Pixel */
            color: #5a9bd4; /* Setzt die Farbe auf Hellblau */
            position: fixed; /* Setzt die Position auf fixiert */
            top: 10px; /* Setzt den oberen Rand auf 10 Pixel */
            left: 10px; /* Setzt den linken Rand auf 10 Pixel */
            border: none; /* Entfernt die Umrandung */
            background-color: transparent; /* Setzt die Hintergrundfarbe auf transparent */
        }
    </style>
</head>

<body>

    <a href="/" class="home-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-house-fill" viewBox="0 0 16 16">
            <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/> <!-- Definiert den Pfad für das Haus-Icon -->
            <path d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"/> <!-- Definiert den Pfad für das Haus-Icon -->
        </svg>
    </a>

    <h1>Looking for support?</h1> <!-- Überschrift für die Seite -->
    <h2>Fill in your username</h2> <!-- Unterüberschrift für die Seite -->
    <div class="main-container">
        <div class="container">
            <div class="input-container">
                <form method="post" action="/support_user" style="display: flex; align-items: center; width: 100%;">
                    <div class="input-wrapper">
                        <input type="text" id="username" name="username" placeholder="Enter User Name" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Enter User Name'" required> <!-- Eingabefeld für den Benutzernamen -->
                    </div>
                    <button type="submit" class="support-button">To Support Chat</button> <!-- Button zum Absenden des Formulars -->
                </form>
            </div>
        </div>
    </div>
</body>

</html>
